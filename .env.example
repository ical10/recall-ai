LLM_MODEL=z-ai/glm-4.5-air
LLM_BASE_URL=https://openrouter.ai/api/v1

# For Authentication with Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SECRET_KEY=change-me-in-production

# For TTS (audio output)
# Dev (Speechify with fast, cheaper model simba-english)
VOICE_AGENT_API_KEY=
VOICE_AGENT_MODEL="simba-english"
VOICE_AGENT_PROVIDER="speechify"

# STT/Pronunciation (audio output -> judgment)
# Dev (Gemini API Key from Google AI Studio)
STT_PROVIDER=gemini
STT_API_KEY=
STT_MODEL=

# R2-related envs (for audio storage)
R2_PUBLIC_URL=

# Creds for S3 clients
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
